# OPENAI_API_KEY: Insert your Groq API key here (routed to Groq OpenAI-compatible Chat Completions API).
# Configure securely via the Secrets panel in AI Studio.
OPENAI_API_KEY=YOUR_GROQ_API_KEY

# GOOGLE_SEARCH_API_KEY: Optional API key for Google Programmable Search Engine (Custom Search JSON API).
GOOGLE_SEARCH_API_KEY=YOUR_GOOGLE_SEARCH_API_KEY

# GOOGLE_SEARCH_CX: Optional Search Engine ID (cx) for Google Programmable Search Engine.
GOOGLE_SEARCH_CX=YOUR_GOOGLE_SEARCH_CX
